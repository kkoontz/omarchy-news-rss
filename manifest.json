{
  "schemaVersion": 1,
  "id": "io.github.kkoontz.omarchy-news-rss",
  "name": "Omarchy News",
  "version": "1.3.1",
  "author": "kevin koontz",
  "license": "MIT",
  "description": "Dedicated panel for official Omarchy and Omacom Foundation news.",
  "homepage": "https://github.com/kkoontz/omarchy-news-rss",
  "kinds": ["bar-widget", "service"],
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "Omarchy News",
    "category": "News",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshMinutes": 15
    },
    "schema": [
      {
        "key": "refreshMinutes",
        "type": "integer",
        "label": "Refresh interval (minutes)",
        "min": 5,
        "max": 1440,
        "step": 1,
        "defaultValue": 15
      }
    ]
  }
}
